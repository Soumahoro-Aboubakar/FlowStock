# --- Serveur -------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/flowstock
CLIENT_URL=http://localhost:5173
# Chaîne aléatoire d'au moins 32 caractères :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_TTL_DAYS=7

# --- Comptes -------------------------------------------------------------
# Adresses qui deviennent administrateur à l'inscription (séparées par des virgules).
ADMIN_EMAILS=
# Verrouillage après N échecs de connexion, pendant X heures.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_HOURS=2
# Mot de passe des comptes de démonstration créés par "npm run seed" (aléatoire si vide).
SEED_DEMO_PASSWORD=

# --- E-mails (Gmail + mot de passe d'application) ------------------------
# Sans ces valeurs, les e-mails sont affichés dans la console du serveur.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Images (Cloudflare R2) ----------------------------------------------
# Sans ces valeurs, les images sont stockées sur le disque (backend/uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL publique du bucket (https://pub-xxxx.r2.dev ou domaine perso). PAS l'endpoint *.r2.cloudflarestorage.com.
# Vide : les images sont servies par l'API sur /media.
R2_PUBLIC_URL=
